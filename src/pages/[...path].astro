---
import Layout from '../layouts/Layout.astro';
import MyTree from '../components/MyTree';
import Order from '../components/Order';
import Admin from '../components/Admin';
import Studio from '../components/Studio';
import AdminLayout from '../layouts/AdminLayout.astro';
import { STORE, feature } from '../lib/store-config';
const path = Astro.params.path || '';
const titles: Record<string, string> = {
  ...(feature('adoption') ? { 'tree/my': STORE.words.myAdoption } : {}),
  order: '查订单',
  'pay/result': '订单与支付结果',
  admin: '运营后台',
  'admin/studio': '网站设置',
};
if (!titles[path]) Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

{path === 'admin' || path === 'admin/studio' ? (
  <AdminLayout title={titles[path] + ' · ' + STORE.brand.name}>
    {path === 'admin' ? <Admin client:load /> : <Studio client:load />}
  </AdminLayout>
) : (
  <Layout title={(titles[path] || '页面未找到') + ' · ' + STORE.brand.name} noindex>
    {path === 'tree/my' && titles[path] && <MyTree client:load />}
    {(path === 'order' || path === 'pay/result') && (
      <Order result={path === 'pay/result'} client:load />
    )}
    {!titles[path] && (
      <div class="section empty-state">
        <span>404</span>
        <h1>这个页面不存在</h1>
        <a href="/" class="button primary">
          回到首页 ↗
        </a>
      </div>
    )}
  </Layout>
)}
