---
import ProductPhoto from '../components/ProductPhoto';
import Layout from '../layouts/Layout.astro';
import {
  APPLE_PRODUCTS,
  APPLE_FAQS,
  BRAND_NAME,
  CONTENT_UPDATED,
  ORIGIN_LABEL,
  SEASON_PRICES,
} from '../lib/content';
import { faqSchema } from '../lib/seo';
import { cnDate, cnMonthDay, money, SEASON_END } from '../lib/shared';
import { STORE, feature } from '../lib/store-config';
const guide = STORE.pages.guide;
const adoption = feature('adoption');
const afterOrder = [
  '查询物流和售后请准备下单手机号与订单号',
  adoption && '；认领预约使用认领码与 PIN 登录',
  '。订单与收件信息不会出现在公开页面中。',
  feature('sponsorship') &&
    '社区活动赞助采用人工审核，具体日期要求、申请材料和返图授权以申请页为准。',
]
  .filter(Boolean)
  .join('');
---

<Layout structuredData={[faqSchema()]}>
  <article class="page-wrap buying-guide">
    <nav class="breadcrumbs" aria-label="面包屑">
      <a href="/">首页</a>
      <span>/</span>
      <span>选购与配送指南</span>
    </nav>
    <header class="guide-heading">
      <div class="eyebrow">{guide.eyebrow}</div>
      <h1>
        {guide.title.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </h1>
      <p>{guide.intro}</p>
      <p class="fine-print">
        {'适用 ' + STORE.season.shortLabel + ' · 更新于 '}
        <time datetime={CONTENT_UPDATED}>{CONTENT_UPDATED}</time>
      </p>
    </header>
    <section class="guide-section">
      <h2>{guide.originTitle}</h2>
      <p>
        {'品牌为「' + BRAND_NAME + '」，产地位于 '}
        <strong>{ORIGIN_LABEL}</strong>
        {'。网站由' + STORE.brand.publisher + '运营，' + guide.originText}
      </p>
    </section>
    <section class="guide-section">
      <h2>{guide.productsTitle}</h2>
      <div class="guide-product-grid">
        {APPLE_PRODUCTS.map((p) => (
          <a href={'/apples/' + p.slug} class="guide-product" data-live-sku={p.sku}>
            <ProductPhoto sku={p.sku} src={p.imageUrl} sizes="(max-width: 1200px) 44vw, 560px" />
            <div>
              <h3>
                <bdi data-live="name">{p.name}</bdi>{' '}
                <span data-live="price">{'¥' + money(SEASON_PRICES[p.sku])}</span>
              </h3>
              <p data-live="spec-line">
                {`${p.count} 个 / 箱 · 单果约 ${p.weight}g · 总重约 ${p.totalKg}kg`}
              </p>
              <span class="text-link">查看这一箱 ↗</span>
            </div>
          </a>
        ))}
      </div>
      <p class="fine-print">规格与约重以文字说明为准，果品和包装以实物为准。</p>
    </section>
    {adoption && (
      <section class="guide-section">
        <h2>如果想认领一整季</h2>
        <p>
          平安树 {'¥' + money(SEASON_PRICES.PA)}，本季共 8 箱，每箱 10 斤；富贵树{' '}
          {'¥' + money(SEASON_PRICES.FG)}，本季共 15 箱，每箱 6
          斤。可分次预约、寄往不同地址；认领箱型与零售箱型不同，不要把两者的每箱个数或重量混用。
        </p>
        <p>
          {`本季不自动续费。全部箱数请在 ${cnDate(SEASON_END)}前预约，期望发货日不早于两天后，且不晚于 ${cnMonthDay(SEASON_END)}；不足量时以同一果园同等级苹果补足。偏远运费按每次预约箱数补差，未预约箱数的处理见认领页规则。`}
        </p>
        <a href="/tree" class="text-link">
          了解苹安树认领 ↗
        </a>
      </section>
    )}
    <section class="guide-section" id="faq">
      <h2>常见问题，逐个说清</h2>
      <div class="faq-list">
        {APPLE_FAQS.map(([q, a]) => (
          <details>
            <summary>
              {q}
              <span>+</span>
            </summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>
    <section class="guide-section">
      <h2>{feature('sponsorship') ? '已经下单，或者想组织一场相聚？' : '已经下单了？'}</h2>
      <p>{afterOrder}</p>
      <div class="detail-links">
        <a href="/order">订单与售后 ↗</a>
        {adoption && <a href="/tree/my">我的苹安树 ↗</a>}
        {feature('sponsorship') && <a href="/treat">申请活动赞助 ↗</a>}
        <a href="/privacy">隐私说明 ↗</a>
      </div>
    </section>
    <p class="fine-print">
      {'本页说明适用于 ' +
        STORE.season.shortLabel +
        '。当前价格、库存、开售状态与运费以下单页为准；需要帮助可从订单页联系运营。'}
    </p>
  </article>
</Layout>
