---
import site from '../../../config/site.json';
export const prerender = true;
import ProductPhoto from '../../components/ProductPhoto';
import Layout from '../../layouts/Layout.astro';
import {
  APPLE_PRODUCTS,
  APPLE_FAQS,
  BRAND_NAME,
  ORIGIN_LABEL,
  SEASON_PRICES,
} from '../../lib/content';
import { productSchema } from '../../lib/seo';
import { money } from '../../lib/shared';
export function getStaticPaths() {
  return APPLE_PRODUCTS.map((product) => ({ params: { slug: product.slug } }));
}
const product = APPLE_PRODUCTS.find((p) => p.slug === Astro.params.slug)!;
const price = '¥' + money(SEASON_PRICES[product.sku]);
// A descriptive offer has a season price, but makes no stale inventory claim.
const schema = [productSchema(product, { price: SEASON_PRICES[product.sku] }, {})];
---

<Layout
  title={
    product
      ? `${BRAND_NAME}${product.name}苹果｜${product.count}个·单果约${product.weight}g·${price}`
      : '商品未找到 · ' + site.name
  }
  image={product?.image}
  imageAlt={product?.imageAlt}
  structuredData={schema}
  noindex={!product}
>
  {product ? (
    <article class="page-wrap product-detail">
      <nav class="breadcrumbs" aria-label="面包屑">
        <a href="/">首页</a>
        <span>/</span>
        <a href="/buy">买苹果</a>
        <span>/</span>
        <span>{product.name}</span>
      </nav>
      <div class="product-detail-grid">
        <figure class="detail-image">
          <ProductPhoto sku={product.sku} sizes="(max-width: 1200px) 50vw, 640px" priority />
          <figcaption>果品和包装以实物为准</figcaption>
        </figure>
        <div class="detail-copy">
          <div class="eyebrow">A BOX OF AUTUMN / {product.slug.toUpperCase()}</div>
          <h1>
            {product.name}
            <span> {product.tagline}</span>
          </h1>
          <p class="detail-origin">{ORIGIN_LABEL}</p>
          <p>{product.description}</p>
          <dl class="spec-grid">
            <div>
              <dt>每箱数量</dt>
              <dd>{product.count} 个</dd>
            </div>
            <div>
              <dt>单果约重</dt>
              <dd>{product.weight}g</dd>
            </div>
            <div>
              <dt>每箱约重</dt>
              <dd>{product.totalKg}kg</dd>
            </div>
            <div>
              <dt>发货快递</dt>
              <dd>常用快递</dd>
            </div>
          </dl>
          <p class="detail-price">
            <strong>{price}</strong>
            <span>/ 箱</span>
          </p>
          <p class="fine-print">价格、库存和可售状态以下单页实时显示为准</p>
          <a class="button primary" href={'/buy?sku=' + product.sku}>
            挑选{product.name} <span>↗</span>
          </a>
          <a class="text-link" href="/guide">
            先看看配送与售后说明 ↗
          </a>
        </div>
      </div>
      <section class="detail-answers">
        <h2>这一箱，先了解清楚</h2>
        <div class="faq-list">
          {APPLE_FAQS.slice(2, 7).map(([q, a]) => (
            <details>
              <summary>
                {q}
                <span>+</span>
              </summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </section>
      <p class="fine-print">果重与总重为近似值，果品和包装以实物为准。</p>
      <a class="text-link" href={'/apples/' + (product.slug === 'family' ? 'gift' : 'family')}>
        再看看{product.slug === 'family' ? '礼盒装' : '家庭装'} ↗
      </a>
    </article>
  ) : (
    <div class="section empty-state">
      <h1>这箱苹果还没上架</h1>
      <a class="button primary" href="/buy">
        看看现有规格 ↗
      </a>
    </div>
  )}
</Layout>
