---
import site from '../../config/site.json';
export const prerender = true;
import { env } from 'cloudflare:workers';
import { ArrowDown, ArrowUpRight, Heart, Mountain, Sprout, Truck } from 'lucide-react';
import ProductPhoto from '../components/ProductPhoto';
import ResponsivePhoto from '../components/ResponsivePhoto';
import { SCENE_IMAGES } from '../lib/media';
import Layout from '../layouts/Layout.astro';
import HomeLive from '../components/HomeLive.astro';
import MobileShop from '../components/MobileShop';
import { APPLE_FAQS, ORIGIN_LABEL } from '../lib/content';
import { faqSchema } from '../lib/seo';
const homeFaqs = [
  APPLE_FAQS[0],
  APPLE_FAQS[2],
  APPLE_FAQS[4],
  APPLE_FAQS[5],
  APPLE_FAQS[3],
  APPLE_FAQS[6],
];
---

<Layout structuredData={[faqSchema(homeFaqs, '/')]}>
  <div class="mobile-only">
    <MobileShop client:media="(max-width: 1000px)" />
  </div>
  <div class="desktop-only">
    <section class="hero">
      <ResponsivePhoto
        photo={SCENE_IMAGES.ORCHARD}
        sizes="100vw"
        priority
        className="hero-picture"
        imageClassName="hero-image"
      />
      {env.HERO_VIDEO_URL && (
        <video
          class="hero-image hero-video"
          muted
          autoplay
          loop
          playsinline
          preload="none"
          poster={SCENE_IMAGES.ORCHARD.thumbnail}
          aria-label="果园秋收短片"
        >
          <source src={env.HERO_VIDEO_URL} type="video/mp4" />
        </video>
      )}
      <div class="hero-shade"></div>
      <div class="hero-content">
        <div class="eyebrow hero-eyebrow">
          <span class="little-line"></span>来自山间果园的一封秋日来信
        </div>
        <h1>
          把山里的秋天，
          <br />
          寄给你
        </h1>
        <p>山间果园的苹果，在枝头慢慢变甜，不赶时间的甜，刚刚好送到你手里。</p>
        <div class="hero-buttons">
          <a class="button red" href="/buy">
            买一箱，尝尝秋天 <ArrowUpRight size={19} aria-hidden="true" />
          </a>
          <a class="button glass" href="/tree">
            认领一棵苹安树 <ArrowUpRight size={19} aria-hidden="true" />
          </a>
        </div>
        <div class="hero-source">
          <span class="source-icon" aria-hidden="true">
            <Mountain size={21} aria-hidden="true" />
          </span>{' '}
          {ORIGIN_LABEL} <span class="source-separator">/</span> 2026 秋收限定
        </div>
      </div>
      <div class="harvest-seal">
        <small>自然熟成</small>
        <strong>
          一年
          <br />
          只等这一季
        </strong>
        <span>THE AUTUMN EDITION</span>
      </div>

      <a href="#story" class="hero-scroll">
        往下，走进果园 <ArrowDown size={17} aria-hidden="true" />
      </a>
    </section>
    <div class="promise-strip">
      <div>
        <span>
          <Mountain size={27} aria-hidden="true" />
        </span>
        <strong>山间果园</strong>
        <small>山地果园，自然的风土</small>
      </div>
      <div>
        <span>
          <Sprout size={27} aria-hidden="true" />
        </span>
        <strong>四季细心照料</strong>
        <small>把细心，留给每颗苹果</small>
      </div>
      <div>
        <span>
          <Truck size={27} aria-hidden="true" />
        </span>
        <strong>苹果从产地出发</strong>
        <small>付款后 48 小时内发货</small>
      </div>
      <div>
        <span>
          <Heart size={27} aria-hidden="true" />
        </span>
        <strong>坏果按个赔</strong>
        <small>一箱心意，好好送到</small>
      </div>
    </div>
    <section class="section story" id="story">
      <div class="story-copy">
        <div class="eyebrow">01 / DEEP IN THE ORCHARD</div>
        <h2>
          苹果的来处，
          <br />
          藏着一整个秋天
        </h2>
        <div class="story-paragraphs">
          <p>{ORIGIN_LABEL}</p>
          <p>每年霜降之后，山里的苹果慢慢染红，一年的等待，也到了收获的时候</p>
          <p>山里的日照和温差，加上果农四季的细心，才有了咬下去的那声脆</p>
          <p>我想把这份清甜的味道，寄得远一点</p>
          <p>让这一箱苹果，成为你和远方的一点连接</p>
        </div>
        <a class="text-link" href="#process">
          一个苹果，要走过怎样的一年 <ArrowUpRight size={19} aria-hidden="true" />
        </a>
      </div>
      <div class="story-visual">
        <ResponsivePhoto
          photo={SCENE_IMAGES.ORCHARD}
          sizes="(max-width: 1100px) 35vw, 512px"
          position="75% 50%"
        />
        <div class="story-note">
          <strong>
            风土有来处，
            <br />
            心意有回响。
          </strong>
          <small>山间果园 · 一季好苹果</small>
        </div>
      </div>
    </section>
    <section class="process-section" id="process">
      <div class="section-inner">
        <div class="eyebrow">A YEAR IN THE ORCHARD</div>
        <div class="section-heading">
          <h2>甜，是慢慢长出来的</h2>
          <p>
            从修剪到装箱，一年的心思，都在这一口里。
            <br />
            每个季节认真照料，收获时仔细挑选。
          </p>
        </div>
        <div class="process-track">
          {[
            ['冬', '修剪整枝', '让树好好休息'],
            ['春', '疏花疏果', '把养分留给好果'],
            ['夏', '细心套袋', '护住每一次生长'],
            ['秋', '摘袋转果', '让阳光均匀照见'],
            ['收', '分级装箱', '把好苹果寄给你'],
          ].map(([season, title, note], i) => (
            <div class="process-step">
              <span class="process-node">{season}</span>
              <small>0{i + 1}</small>
              <h3>{title}</h3>
              <p>{note}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="section shop-section">
      <div class="eyebrow">02 / A BOX OF AUTUMN</div>
      <div class="section-heading">
        <h2>
          自己吃，是日常
          <br />
          送给你，是心意
        </h2>
        <a class="text-link" href="/buy">
          选一箱你的秋天 <ArrowUpRight size={18} aria-hidden="true" />
        </a>
      </div>
      <div class="product-grid">
        <article class="product-card">
          <a href="/apples/family" class="product-photo family" aria-label="查看家庭装详情">
            <ProductPhoto sku="FAMILY" sizes="(max-width: 1200px) 44vw, 560px" />
            <span class="tag">把日子，过得脆甜</span>
          </a>
          <div class="product-info">
            <span class="eyebrow">FOR EVERYDAY</span>
            <div class="product-heading">
              <h3>
                <a href="/apples/family">家庭装</a>
              </h3>
              <div class="product-price">
                <strong>¥{site.prices.FAMILY / 100}</strong>
                <small>/ 箱</small>
              </div>
            </div>
            <div class="product-purchase-row">
              <dl class="product-specs">
                <div>
                  <dt>数量</dt>
                  <dd>22 个 / 箱</dd>
                </div>
                <div>
                  <dt>单果重量</dt>
                  <dd>约 250g</dd>
                </div>
                <div>
                  <dt>整箱重量</dt>
                  <dd>约 5.5kg</dd>
                </div>
              </dl>
              <a
                class="button red product-action"
                href="/buy?sku=FAMILY"
                aria-label="立即下单家庭装"
              >
                立即下单 <ArrowUpRight size={18} aria-hidden="true" />
              </a>
            </div>
          </div>
        </article>
        <article class="product-card">
          <a href="/apples/gift" class="product-photo gift" aria-label="查看礼盒装详情">
            <ProductPhoto sku="GIFT" sizes="(max-width: 1200px) 44vw, 560px" />
            <span class="tag">好好挑，慢慢送</span>
          </a>
          <div class="product-info">
            <span class="eyebrow">FOR SOMEONE SPECIAL</span>
            <div class="product-heading">
              <h3>
                <a href="/apples/gift">礼盒装</a>
              </h3>
              <div class="product-price">
                <strong>¥{site.prices.GIFT / 100}</strong>
                <small>/ 箱</small>
              </div>
            </div>
            <div class="product-purchase-row">
              <dl class="product-specs">
                <div>
                  <dt>数量</dt>
                  <dd>8 个 / 箱</dd>
                </div>
                <div>
                  <dt>单果重量</dt>
                  <dd>约 350g</dd>
                </div>
                <div>
                  <dt>整箱重量</dt>
                  <dd>约 2.8kg</dd>
                </div>
              </dl>
              <a class="button red product-action" href="/buy?sku=GIFT" aria-label="立即下单礼盒装">
                立即下单 <ArrowUpRight size={18} aria-hidden="true" />
              </a>
            </div>
          </div>
        </article>
      </div>
      <p class="fine-print centered">包邮 · 可附赠手写心意卡 · 偏远地区每箱补运费差价，默认 ¥20</p>
    </section>
    <section class="connection-section">
      <div class="section-inner">
        <div class="eyebrow">03 / MORE THAN AN APPLE</div>
        <h2>
          从一颗苹果，
          <br />
          长出更多连接
        </h2>
        <div class="connection-grid">
          <a href="/tree" class="connection-card tree-card">
            <figure class="connection-image">
              <ResponsivePhoto
                photo={SCENE_IMAGES.ADOPTION}
                sizes="(max-width: 1200px) 42vw, 520px"
              />
            </figure>
            <span class="eyebrow">YOUR OWN LITTLE ORCHARD</span>
            <h3>认领一棵苹安树</h3>
            <p>
              给树挂上你的名字，把这一季的甜，
              <br />
              分几次寄给在意的人。
            </p>
            <span class="connection-bottom">
              ¥{site.prices.PA / 100} 起 / 本季 <ArrowUpRight size={21} aria-hidden="true" />
            </span>
          </a>
          <a href="/treat" class="connection-card treat-card">
            <figure class="connection-image">
              <ResponsivePhoto
                photo={SCENE_IMAGES.COMMUNITY}
                sizes="(max-width: 1200px) 42vw, 520px"
              />
            </figure>
            <span class="eyebrow">GOOD APPLES, GOOD COMPANY</span>
            <h3>{site.publisher}请你吃苹果</h3>
            <p>
              读书会、技术聚会，或一次久违的相聚。
              <br />
              你们聚在一起，苹果算我的。
            </p>
            <span class="connection-bottom">
              申请社区活动赞助 <ArrowUpRight size={21} aria-hidden="true" />
            </span>
          </a>
        </div>
      </div>
    </section>
    <HomeLive />
    <section class="aftercare section">
      <div>
        <div class="eyebrow">A LITTLE PROMISE</div>
        <h2>
          从枝头到手里，
          <br />
          都想照顾好你
        </h2>
      </div>
      <div class="faq-list">
        {homeFaqs.map(([q, a]) => (
          <details>
            <summary>
              {q}
              <span>+</span>
            </summary>
            <p>{a}</p>
          </details>
        ))}
        <div class="faq-guide-row">
          <a class="faq-guide" href="/guide">
            完整选购与配送指南 <ArrowUpRight size={20} aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
