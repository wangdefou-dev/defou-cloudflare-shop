---
import site from '../../config/site.json';
import StoreLayout from './StoreLayout.astro';
import OrchardLayout from './OrchardLayout.astro';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  structuredData?: Record<string, unknown>[];
  noindex?: boolean;
}
const Frame = site.features.orchard ? OrchardLayout : StoreLayout;
---

<Frame {...Astro.props}>
  <slot />
</Frame>
