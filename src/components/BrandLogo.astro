---
import { STORE } from '../lib/store-config';
// 网站设置 → 网站内容 → 品牌与联系 → Logo replaces the text logo with an uploaded image.
const custom = STORE.brand.logo as { src: string; width: number; height: number } | null;
interface Props {
  footer?: boolean;
}
const { footer = false } = Astro.props;
---

{custom ? (
  <img
    class="brand-logo"
    src={custom.src}
    width={custom.width}
    height={custom.height}
    alt={STORE.brand.name}
    loading={footer ? 'lazy' : 'eager'}
    decoding="async"
  />
) : (
  <span class:list={['brand-text-logo', { footer }]}>
    <img src="/brand/apple-mark.svg" width="34" height="34" alt="" aria-hidden="true" />
    {STORE.brand.name}
  </span>
)}
