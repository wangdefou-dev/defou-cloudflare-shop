{
  "name": "defou-cloudflare-shop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "build:production": "npm run config:check && CLOUDFLARE_ENV=production astro build && npm run verify:public",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "tsx --test tests/*.test.ts",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file scripts/seed.sql && wrangler d1 execute DB --local --file scripts/seed-content.sql",
    "deploy": "npm run deploy:production",
    "deploy:production": "npm run build:production && wrangler deploy",
    "types": "wrangler types",
    "verify:public": "node scripts/check-public-build.mjs",
    "verify:pages": "node scripts/check-pages.mjs",
    "catalog:pull": "node scripts/pull-catalog.mjs",
    "config:check": "tsx scripts/check-config.ts",
    "db:demo": "wrangler d1 execute DB --local --file scripts/regions.sql && wrangler d1 execute DB --local --file scripts/demo-stock.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/preact": "6.1.1",
    "astro": "7.4.2",
    "china-division": "^2.7.0",
    "jose": "^6.0.0",
    "lucide-react": "^1.0.0",
    "preact": "11.0.1",
    "react": "^19.2.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@cloudflare/workers-types": "latest",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "node": "^24.22.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.156.2"
  },
  "description": "Cloudflare Workers 上的独立商店：可在后台随时修改文案和配图，支持 Stripe 支付、库存、发货、优惠券与退款。",
  "license": "MIT"
}
